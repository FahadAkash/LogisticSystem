# PostgreSQL Configuration
DB_HOST=192.168.0.113
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_pass

DATABASE_URL=postgresql://postgres:your_secure_postgres_pass@192.168.0.113:5432/appdb

POSTGRES_HOST=192.168.0.113
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_pass
POSTGRES_DB=appdb
POSTGRES_SSLMODE=disable

# Redis Configuration
REDIS_HOST=192.168.0.113
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_pass
REDIS_URL=redis://:your_secure_redis_pass@192.168.0.113:6379/0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=192.168.0.113:9094

# ASP.NET Connection Strings
ConnectionStrings__PostgreSql=Host=192.168.0.113;Port=5432;Database=appdb;Username=postgres;Password=your_secure_postgres_pass;SearchPath=core,public;
ConnectionStrings__Redis=192.168.0.113:6379,password=your_secure_redis_pass,abortConnect=false
