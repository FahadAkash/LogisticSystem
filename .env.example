# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_pass
POSTGRES_DB=appdb
POSTGRES_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_pass

# ASP.NET Connection Strings
ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=appdb;Username=postgres;Password=your_secure_postgres_pass;
ConnectionStrings__Redis=localhost:6379,password=your_secure_redis_pass,abortConnect=false

