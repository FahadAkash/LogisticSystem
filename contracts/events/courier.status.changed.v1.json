{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourierStatusChangedPayloadV1",
  "type": "object",
  "required": [
    "courierId",
    "fromStatus",
    "toStatus",
    "occurredAt"
  ],
  "properties": {
    "courierId": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier of the courier (= core.couriers.id)"
    },
    "fromStatus": {
      "type": "string",
      "description": "Previous courier status"
    },
    "toStatus": {
      "type": "string",
      "enum": ["PendingApproval", "Offline", "Available", "Busy", "Suspended"],
      "description": "New courier status"
    },
    "vehicleType": {
      "type": ["string", "null"],
      "description": "Vehicle type associated with the courier"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the status changed"
    }
  },
  "additionalProperties": false
}

